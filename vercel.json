{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {"key": "Cache-Control", "value": "no-store, no-cache, must-revalidate"},
        {"key": "Vary", "value": "Accept-Encoding"}
      ]
    }
  ],
  "rewrites": [
    { "source": "/(.*)", "destination": "/GNDCTRL/admin.html" }
  ],
  "framework": null
}
